# Copy this file to .env and fill in your keys.

# Postgres (Neon). Leave empty to use a local SQLite file.
DATABASE_URL=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Flight status by flight number (free tier is fine to start)
AVIATIONSTACK_API_KEY=

# Optional. OpenSky works anonymously with lower rate limits.
# Create an API client in your OpenSky account to get these.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

MAX_AGENT_ITERATIONS=6

# Phone notifications via ntfy (install the ntfy app, subscribe to this topic).
# Make it long and random: anyone who knows the topic can read it.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Tracker
DB_PATH=flight_agent.db
MAX_CHECKS_PER_FLIGHT=30
